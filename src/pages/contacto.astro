---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contacto - Makkeroni" lang="es">
  <h1>¿Dónde Estamos? Ven a Conocernos</h1>
  <img src="/images/vetrina-negozio.jpg" alt="Escaparate de Makkeroni" style="width:100%;border-radius:8px;margin-bottom:1rem;" loading="lazy" />
  <p>Calle Maria Aguilo 62, 08005 Barcelona (Poblenou)</p>
  <p>Teléfono: <a href="tel:933821436">933821436</a></p>
  <p>Email: <a href="mailto:hola@makkeroni.com">hola@makkeroni.com</a></p>
  <p>WhatsApp: <a href="https://wa.me/34685031676">+34 685 03 16 76</a></p>

  <h2>Horario</h2>
  <p>Lunes a Sábado: 10:00–14:00 / 17:00–20:00<br/>Domingo: cerrado</p>

  <h2>Escríbenos</h2>
  <form action="https://formspree.io/f/TU_ID_FORMSPREE" method="POST">
    <p><label>Nombre<br/><input type="text" name="nombre" required style="width:100%;padding:0.5rem;" /></label></p>
    <p><label>Email<br/><input type="email" name="email" required style="width:100%;padding:0.5rem;" /></label></p>
    <p><label>Mensaje<br/><textarea name="mensaje" required style="width:100%;padding:0.5rem;" rows="5"></textarea></label></p>
    <p><label><input type="checkbox" required /> Acepto la <a href="/politica-de-privacidad">política de privacidad</a></label></p>
    <button type="submit" style="background:#1c5c34;color:white;border:none;padding:0.7rem 1.5rem;border-radius:4px;cursor:pointer;">Enviar</button>
  </form>
  <p style="font-size:0.85rem;opacity:0.7;">Nota: sustituir TU_ID_FORMSPREE con el ID real de tu cuenta Formspree.</p>
</Layout>
