---
export interface Props {
  title: string;
  description?: string;
  lang?: string;
}
const { title, description = "Makkeroni - Gastronomia italiana a Barcellona", lang = "es" } = Astro.props;

const nav = {
  es: { home: "/", historia: "/quien-somos", productos: "/nuestros-productos", recetas: "/recetas", contacto: "/contacto" },
  it: { home: "/it/", historia: "/it/chi-siamo", productos: "/it/prodotti", recetas: "/it/ricette", contacto: "/it/contatti" },
  en: { home: "/en/", historia: "/en/about", productos: "/en/products", recetas: "/en/recipes", contacto: "/en/contact" },
  ca: { home: "/ca/", historia: "/ca/historia", productos: "/ca/productes", recetas: "/ca/receptes", contacto: "/ca/contacte" },
};

const labels = {
  es: { home: "Inicio", historia: "Quién somos", productos: "Nuestros productos", recetas: "Recetas", contacto: "Contacto" },
  it: { home: "Home", historia: "Chi siamo", productos: "Prodotti", recetas: "Ricette", contacto: "Contatti" },
  en: { home: "Home", historia: "About us", productos: "Products", recetas: "Recipes", contacto: "Contact" },
  ca: { home: "Inici", historia: "Qui som", productos: "Productes", recetas: "Receptes", contacto: "Contacte" },
};

const l = labels[lang];
const n = nav[lang];
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/png" href="/images/logo-makkeroni.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700&family=Nunito+Sans:wght@400;600&display=swap" rel="stylesheet" />
  <style>
    :root {
      --verde: #1c5c34;
      --rosso: #b3261e;
      --crema: #faf6ef;
      --testo: #2b2b2b;
    }
    * { box-sizing: border-box; }
img {
  max-width: 100%;
  height: auto;
  display: block;
}
    body {
      margin: 0;
      font-family: 'Nunito Sans', sans-serif;
      background: var(--crema);
      color: var(--testo);
      line-height: 1.65;
    }
    h1, h2, h3 { font-family: 'Montserrat', sans-serif; }

    header {
      background: var(--verde);
      color: white;
      padding: 0.7rem 1.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 100;
      box-shadow: 0 2px 8px rgba(0,0,0,0.15);
    }
    header a { color: white; text-decoration: none; }
    .logo-link { display: flex; align-items: center; gap: 0.6rem; }
    .logo-link img { height: 42px; width: auto; display: block; }
    .logo-text { font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 1.3rem; letter-spacing: 0.5px; }

    .desktop-nav ul {
      list-style: none;
      display: flex;
      gap: 1.3rem;
      margin: 0;
      padding: 0;
      align-items: center;
    }
    .desktop-nav a:hover { text-decoration: underline; }
    .lang-switch { display: flex; gap: 0.5rem; font-size: 0.8rem; margin-left: 0.5rem; }
    .lang-switch a { opacity: 0.8; padding: 0.15rem 0.35rem; }
    .lang-switch a.active { opacity: 1; font-weight: 700; text-decoration: underline; }

    .burger {
      display: none;
      background: none;
      border: none;
      color: white;
      font-size: 1.8rem;
      cursor: pointer;
      line-height: 1;
    }

    .mobile-nav {
      display: none;
      flex-direction: column;
      background: var(--verde);
      padding: 0 1.5rem 1rem;
    }
    .mobile-nav.open { display: flex; }
    .mobile-nav a {
      padding: 0.7rem 0;
      border-top: 1px solid rgba(255,255,255,0.2);
      font-size: 1.05rem;
    }
    .mobile-nav .lang-switch { padding-top: 0.7rem; border-top: 1px solid rgba(255,255,255,0.2); }

    @media (max-width: 767px) {
      .desktop-nav { display: none; }
      .burger { display: block; }
    }

    main {
      max-width: 900px;
      margin: 0 auto;
      padding: 2rem 1.5rem 4rem;
    }
    h1 { color: var(--verde); font-size: 2rem; }
    h2 { color: var(--rosso); border-bottom: 2px solid var(--rosso); padding-bottom: 0.3rem; font-size: 1.4rem; margin-top: 2.2rem; }

    @media (max-width: 767px) {
      main { padding: 1.2rem 1rem 3rem; }
      h1 { font-size: 1.5rem; }
      h2 { font-size: 1.2rem; }
    }

    .reveal {
      opacity: 0;
      transform: translateY(16px);
      transition: opacity 0.6s ease, transform 0.6s ease;
    }
    .reveal.is-visible { opacity: 1; transform: translateY(0); }

    .photo-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.8rem;
      margin: 1.5rem 0;
    }
    .photo-grid img {
      width: 100%;
      height: 160px;
      object-fit: cover;
      border-radius: 6px;
    }
    @media (max-width: 767px) {
      .photo-grid { grid-template-columns: repeat(2, 1fr); }
      .photo-grid img { height: 120px; }
    }

    .hero {
      position: relative;
      margin: -2rem -1.5rem 2rem;
      min-height: 320px;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      background-size: cover;
      background-position: center;
      color: white;
      padding: 2rem;
    }
    .hero::before {
      content: "";
      position: absolute;
      inset: 0;
      background: rgba(0,0,0,0.45);
    }
    .hero-content { position: relative; z-index: 1; max-width: 700px; }
    .hero-content h1 { color: white; }
    @media (max-width: 767px) {
      .hero { margin: -1.2rem -1rem 1.5rem; min-height: 240px; padding: 1.2rem; }
    }

    footer {
      background: var(--verde);
      color: white;
      padding: 2rem 1.5rem;
      text-align: center;
      font-size: 0.9rem;
    }
    footer a { color: white; }
    .wa-float {
      position: fixed;
      bottom: 20px;
      right: 20px;
      background: #25D366;
      color: white;
      border-radius: 50%;
      width: 56px;
      height: 56px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.6rem;
      text-decoration: none;
      box-shadow: 0 2px 8px rgba(0,0,0,0.3);
      z-index: 90;
    }
  </style>
</head>
<body>
  <header>
    <a href={n.home} class="logo-link">
      <img src="/images/logo-makkeroni.png" alt="Makkeroni" />
      <span class="logo-text">MAKKERONI</span>
    </a>

    <nav class="desktop-nav">
      <ul>
        <li><a href={n.home}>{l.home}</a></li>
        <li><a href={n.historia}>{l.historia}</a></li>
        <li><a href={n.productos}>{l.productos}</a></li>
        <li><a href={n.recetas}>{l.recetas}</a></li>
        <li><a href={n.contacto}>{l.contacto}</a></li>
        <li class="lang-switch">
          <a href="/" class:list={[lang === 'es' && 'active']}>ES</a>
          <a href="/it/" class:list={[lang === 'it' && 'active']}>IT</a>
          <a href="/en/" class:list={[lang === 'en' && 'active']}>EN</a>
          <a href="/ca/" class:list={[lang === 'ca' && 'active']}>CA</a>
        </li>
      </ul>
    </nav>

    <button class="burger" id="burgerBtn" aria-label="Menu">☰</button>
  </header>

  <nav class="mobile-nav" id="mobileNav">
    <a href={n.home}>{l.home}</a>
    <a href={n.historia}>{l.historia}</a>
    <a href={n.productos}>{l.productos}</a>
    <a href={n.recetas}>{l.recetas}</a>
    <a href={n.contacto}>{l.contacto}</a>
    <div class="lang-switch">
      <a href="/" class:list={[lang === 'es' && 'active']}>ES</a>
      <a href="/it/" class:list={[lang === 'it' && 'active']}>IT</a>
      <a href="/en/" class:list={[lang === 'en' && 'active']}>EN</a>
      <a href="/ca/" class:list={[lang === 'ca' && 'active']}>CA</a>
    </div>
  </nav>

  <main>
    <slot />
  </main>

  <footer>
    <p>GASTRONOMIA MAKKERONI SCP — CALLE MARIA AGUILO 62, 08005 Barcelona</p>
    <p>
      <a href="tel:933821436">933821436</a> ·
      <a href="mailto:hola@makkeroni.com">hola@makkeroni.com</a> ·
      <a href="https://wa.me/34685031676">WhatsApp</a>
    </p>
    <p>
      <a href="https://facebook.com/makkeroni.gastronomia.italiana.BCN">Facebook</a> ·
      <a href="https://instagram.com/makkeroni_bcn">Instagram</a>
    </p>
    <p style="opacity:0.8; font-size:0.8rem;">
      © 2026 Gastronomia Makkeroni SCP — Tots els drets reservats
    </p>
  </footer>

  <a class="wa-float" href="https://wa.me/34685031676" aria-label="WhatsApp" target="_blank">💬</a>

  <script>
    const burger = document.getElementById('burgerBtn');
    const mobileNav = document.getElementById('mobileNav');
    burger?.addEventListener('click', () => {
      mobileNav?.classList.toggle('open');
      burger.textContent = mobileNav?.classList.contains('open') ? '✕' : '☰';
    });

    const revealEls = document.querySelectorAll('main > *');
    revealEls.forEach(el => el.classList.add('reveal'));
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });
    revealEls.forEach(el => observer.observe(el));
  </script>
</body>
</html>
